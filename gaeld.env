APP_NAME=Gäld
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://gaeld.localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_AVAILABLE_LOCALES=en,fr,de,it

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gaeld
DB_USERNAME=gaeld
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
# Set to true when APP_URL is https://
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Community Edition defaults. Enterprise-only features stay off.
FEATURE_BANK_SYNC=false
FEATURE_AUTOMATION=false
FEATURE_MULTI_CURRENCY=false
FEATURE_API_ACCESS=true
FEATURE_AUTO_RECONCILIATION=false
FEATURE_RULE_ENGINE=false
FEATURE_ADVANCED_PERMISSIONS=false

# Trust the local web server when it terminates TLS.
TRUSTED_PROXIES=127.0.0.1

# Receipt OCR. Install tesseract and the deu/fra/eng language data.
TESSERACT_BINARY=/usr/bin/tesseract
TESSERACT_LANG=deu+fra+eng
OCR_DAILY_LIMIT=3

# WebAuthn / passkeys. Set WEBAUTHN_ID to the site hostname.
WEBAUTHN_NAME="${APP_NAME}"
WEBAUTHN_ID=gaeld.localhost

DOCS_BASE_URL=https://docs.gaeld.ch

SCOUT_DRIVER=database

BACKUP_PATH=/var/lib/gaeld/backups
# BACKUP_ARCHIVE_PASSWORD=

ACTIVITY_LOGGER_ENABLED=true
PLUGINS_ENABLED=false

SANCTUM_TOKEN_EXPIRATION=10080
SCHEDULE_HEARTBEAT_URL=
