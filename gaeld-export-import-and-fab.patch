+    private function applyHeaderMapping(string $headerLine, DataType $dataType): void
+    {
+        if ($this->columnMapping !== []) {
+            return;
+        }
+
+        $headerLine = ltrim($headerLine, "\xEF\xBB\xBF");
+        if (substr_count($headerLine, ';') > substr_count($headerLine, ',')) {
+            $this->delimiter = ';';
+        }
+
+        $headers = str_getcsv(trim($headerLine), $this->delimiter);
+        $aliases = match ($dataType) {
+            DataType::Expenses => [
+                'date' => ['date'],
+                'amount' => ['amount'],
+                'vat_amount' => ['vat amount'],
+                'description' => ['description'],
+                'category' => ['category'],
+                'supplier_name' => ['vendor', 'supplier'],
+                'currency' => ['currency'],
+                'status' => ['status'],
+            ],
+            default => [],
+        };
+
+        if ($aliases === []) {
+            return;
+        }
+
+        $normalized = [];
+        foreach ($headers as $index => $header) {
+            $normalized[$index] = strtolower(trim((string) $header));
+        }
+
+        foreach ($aliases as $field => $names) {
+            foreach ($normalized as $index => $header) {
+                if (in_array($header, $names, true)) {
+                    $this->columnMapping[$field] = $index;
+                    break;
+                }
+            }
+        }
+    }
